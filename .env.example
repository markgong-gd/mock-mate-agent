# ============ 运行 ============
# NODE_ENV 不要写在 .env 中（会影响 Vite 构建模式）；默认 development，生产镜像中为 production
PORT=3000
LOG_LEVEL=info
# 开发服务器（pnpm dev 的前端）：默认只监听 localhost:5173
# 需要从其他机器用 IP 访问时：DEV_HOST=0.0.0.0，DEV_PORT=自定义端口
# DEV_HOST=0.0.0.0
# DEV_PORT=5199

# ============ 数据库 ============
# 本地：docker compose up -d db
DATABASE_URL=postgres://mockmate:mockmate@localhost:5432/mockmate
DB_POOL_MAX=6
# 生产 / 单镜像部署时由应用在启动阶段执行迁移
MIGRATE_ON_START=false

# ============ 身份与访问 ============
# 无正式鉴权时注入的固定用户
DEV_USER_ID=00000000-0000-4000-8000-000000000001
# 部署到公网时必须设置；为空则不启用 accessGate
ACCESS_PASSWORD=
# 签名 Cookie 的密钥（≥32 位），启用 ACCESS_PASSWORD 时必填：openssl rand -hex 32
COOKIE_SECRET=
# 开发调试路由（/api/dev/*），生产默认关闭
# ENABLE_DEV_ROUTES=true

# ============ 备份（部署时使用）============
# BACKUP_DIR=/mnt/workspace/backups
# BACKUP_KEEP=7
# BACKUP_CRON=0 3 * * *

# ============ 模型 provider ============
# 逗号分隔的 provider 名称；每个 provider 用 PROVIDER_<NAME>_* 配置
# KIND 可选：openai-compatible | deepseek | ollama | fake（本地离线假模型，无需 Key）
# 填好 Key 后把对应 provider 加入 PROVIDERS，例如 PROVIDERS=fake,deepseek,glm
PROVIDERS=fake

PROVIDER_FAKE_KIND=fake

# PROVIDER_DEEPSEEK_KIND=deepseek
# PROVIDER_DEEPSEEK_API_KEY=

# PROVIDER_GLM_KIND=openai-compatible
# PROVIDER_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# PROVIDER_GLM_API_KEY=

# PROVIDER_QWEN_KIND=openai-compatible
# PROVIDER_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# PROVIDER_QWEN_API_KEY=

# PROVIDER_OLLAMA_KIND=ollama
# PROVIDER_OLLAMA_BASE_URL=http://localhost:11434

# ============ 模型别名（业务只认别名）============
# 格式 <provider>:<model>。填好 Key 后把 fake 换成真实 provider 即可切换
MODEL_CHAT=fake:echo
MODEL_JUDGE=fake:echo
MODEL_EXTRACT=fake:echo
# MODEL_FALLBACK=glm:glm-4-flash
# MODEL_CHAT=deepseek:deepseek-chat
# MODEL_EXTRACT=glm:glm-4-flash

# 向量化（P1-08 已定：1024 维）。默认 fake 哈希向量，离线可跑通检索。
# 换成真实模型只改下面两行，然后保存档案会按 embed_model 重新向量化：
#   百炼  MODEL_EMBED=qwen:text-embedding-v4
#   硅基  MODEL_EMBED=siliconflow:BAAI/bge-m3
#   本地  MODEL_EMBED=ollama:bge-m3
MODEL_EMBED=fake:hash
EMBEDDING_DIM=1024

# 能力表覆盖（JSON，按别名）：未内置的模型可在此声明
# MODEL_CAPS_EXTRACT={"jsonSchema":false,"tools":false,"jsonMode":true}

# 对外开放时改为国内已备案 provider 白名单
ALLOWED_PROVIDERS=*

LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
# fake 模型逐字输出的间隔（毫秒）
FAKE_LLM_DELAY_MS=25

# ============ 前端（仅 VITE_* 会进入浏览器）============
VITE_APP_NAME=MockMate
